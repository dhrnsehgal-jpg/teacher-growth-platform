# ---------------------------------------------------------------------------
# Teacher Professional Growth Platform — environment template
# Copy to `.env.local`. Never commit real values.
# ---------------------------------------------------------------------------

# Supabase project ------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key

# Server-only. Bypasses Row Level Security — never expose to the browser and
# never use it in a request path that serves teacher-visible data.
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# Application -----------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Data residency guard --------------------------------------------------------
# The DPDP Act, 2023 permits transfer outside India except to restricted
# territories notified by the Central Government. Record the chosen region so
# deployment reviews can evidence it. See docs/SECURITY_PRIVACY.md.
DATA_REGION=ap-south-1

# Password-free demo walkthrough --------------------------------------------
# Set to 1 ONLY for a local demo. It exposes /open and /api/demo-user, which
# sign in as a seeded persona without a password. Both 404 unless this is
# exactly "1" AND the build is not production. Never set it on a deployment.
DEMO_NO_LOGIN=
