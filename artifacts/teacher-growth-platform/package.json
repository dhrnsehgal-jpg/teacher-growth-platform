{
  "name": "@workspace/teacher-growth-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Teacher Professional Growth, Competency, KPI, CPD, Appraisal and Career Progression Platform for CBSE-affiliated schools (Punjab, India).",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -H 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:clean": "rm -rf .next && supabase db reset && playwright test",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:bootstrap": "./scripts/supabase-bootstrap.sh",
    "db:lint": "supabase db lint --level warning",
    "db:diff": "supabase db diff",
    "db:types": "supabase gen types typescript --local --schema public,core,regulatory,audit,competency,kpi,evidence,growth > src/types/database.ts",
    "check": "npm run check:e2e-demo-logins && npm run lint && npm run typecheck && npm run test",
    "check:e2e-demo-logins": "node scripts/check-e2e-demo-logins.mjs",
    "check:api-contracts": "node scripts/check-api-contracts.mjs",
    "check:hosted": "node scripts/check-hosted.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.47.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.468.0",
    "next": "^16.3.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.0",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.17.0",
    "@next/eslint-plugin-next": "^15.5.23",
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@typescript-eslint/eslint-plugin": "^8.19.0",
    "@typescript-eslint/parser": "^8.19.0",
    "@vitest/coverage-v8": "^4.1.11",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.3",
    "pg": "^8.23.0",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "supabase": "^2.2.1",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  }
}
